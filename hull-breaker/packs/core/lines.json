   "sub": 2.8,
   "file": "voice/secret_4.mp3"
  },
  {
   "id": "secret_5",
   "text": "Don't mind if I do.",
   "role": "secret",
   "sub": 2.8,
   "file": "voice/secret_5.mp3"
  },
  {
   "id": "secret_6",
   "text": "Hidden stash. The bank's gonna love this.",
   "role": "secret",
   "sub": 2.8,
   "file": "voice/secret_6.mp3"
