 "rules": [
  {
   "on": {
    "event": "start"
   },
   "do": [
    {
     "say": "start",
     "sub": 3.6
    },
    {
     "objective": "Get inside the ship. Take the transit corridor north out of the docking bay.",
     "show": 7
    }
   ]
  },
  {
   "on": {
    "event": "enterZone",
    "zone": "hub"
   },
   "do": [
    {
     "objective": "Find a keycard. Try the crew deck, north of the atrium."
    },
    {
     "ambush": "hub",
     "delay": 1.2
    }
   ]
  },
  {
   "on": {
    "event": "enterZone",
    "zone": "reception"
   },
   "do": [
    {
     "ambush": "reception",
     "delay": 0.8
    }
   ]
  },
  {
   "on": {
    "event": "enterZone",
    "zone": "hydro"
   },
   "do": [
    {
     "ambush": "hydro",
     "delay": 2
    },
    {
     "say": "salad_bar",
     "sub": 2.8
    }
   ]
  },
  {
   "on": {
    "event": "enterZone",
    "zone": "cargo"
   },
   "do": [
    {
     "ambush": "cargo",
     "delay": 2
    }
   ]
  },
  {
   "on": {
    "event": "enterZone",
    "zone": "security"
   },
   "do": [
    {
     "ambush": "security",
     "delay": 1.5
    }
   ]
  },
  {
   "on": {
    "event": "enterZone",
    "zone": "hall"
   },
   "if": {
    "not": {
     "flag": "power"
    }
   },
   "do": [
    {
     "objective": "Reset the three breakers: one here in Engineering, one in the Coolant Pumps, one in the Reactor room."
    }
   ]
  },
  {
   "on": {
    "event": "pickup",
    "item": "keyB"
   },
   "do": [
    {
     "msg": "BLUE KEYCARD ACQUIRED"
    },
    {
     "sfx": "key"
    },
    {
     "say": "blue_card",
     "sub": 3
    },
    {
     "objective": "The blue door is on the east side of the atrium. Get the power back on in Engineering."
    },
    {
     "ambush": "blue",
     "delay": 2.5
    },
    {
     "autosave": "events"
    }
   ]
  },
  {
   "on": {
    "event": "pickup",
    "item": "keyY"
   },
   "do": [
    {
     "msg": "YELLOW KEYCARD ACQUIRED"
    },
    {
     "sfx": "key"
    },
    {
     "say": "yellow_card",
     "sub": 3
    },
    {
     "objective": "The yellow door is on the south side of the atrium. Find the red keycard in Cargo."
    },
    {
     "ambush": "yellow",
     "delay": 3
    },
    {
     "autosave": "events"
    }
   ]
  },
  {
   "on": {
    "event": "pickup",
    "item": "keyR"
   },
   "do": [
    {
     "msg": "RED KEYCARD ACQUIRED"
    },
    {
     "sfx": "key"
    },
    {
     "say": "red_card",
     "sub": 3
    },
    {
     "objective": "The red door is on the east side of the crew mess. Trigger the tram override on the Bridge."
    },
    {
     "ambush": "red",
     "delay": 2
    },
    {
     "autosave": "events"
    }
   ]
  },
  {
   "on": {
    "event": "use",
    "target": "breaker"
   },
   "do": [
    {
     "setTile": "after"
    },
    {
     "add": "breakers",
     "value": 1
    },
    {
     "sfx": "breaker"
    },
    {
     "shake": 0.2
    },
    {
     "msg": "BREAKER RESET ({breakers}/3)"
    },
    {
     "if": {
      "counter": "breakers",
      "gte": 3
     },
     "then": [
      {
       "set": "power",
       "value": true
      },
      {
       "sfx": "powerup"
      },
      {
       "flash": 1.5,
       "color": [
        1,
        0.9,
        0.7
       ]
      },
      {
       "msg": "MAIN POWER RESTORED"
      },
      {
       "objective": "Power's on. Get the yellow keycard from the Chief Engineer's office, north side of Engineering."
      },
      {
       "ambush": "power",
       "delay": 2.5
      },
      {
       "autosave": "events"
      },
      {
       "say": "lights_on",
       "sub": 3.2
      }
     ],
     "else": [
      {
       "objective": "Breakers reset: {breakers} of 3. Check Engineering, the Coolant Pumps, and the Reactor room."
      },
      {
       "if": {
        "counter": "breakers",
        "eq": 1
       },
       "then": [
        {
         "say": "one_down",
         "sub": 1.8
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "on": {
    "event": "use",
    "target": "override"
   },
   "do": [
    {
     "if": {
      "flag": "override"
     },
     "then": [
      {
       "msg": "OVERRIDE ALREADY ENGAGED"
      }
     ],
     "else": [
      {
       "if": {
        "not": {
         "flag": "power"
        }
       },
       "then": [
        {
         "msg": "NO POWER. RESTORE MAIN POWER FIRST."
        },
        {
         "sfx": "denied"
        }
       ],
       "else": [
        {
         "if": {
          "not": {
           "key": "R"
          }
         },
         "then": [
          {
           "msg": "RED KEYCARD REQUIRED."
          },
          {
           "sfx": "denied"
          }
         ],
         "else": [
          {
           "set": "override",
           "value": true
          },
          {
           "set": "lightsOut",
           "value": true
          },
          {
           "set": "alarm",
           "value": true
          },
          {
           "msg": "TRAM OVERRIDE ENGAGED"
          },
          {
           "msg": "WARNING: CONTAINMENT FAILURE ON DECK 1"
          },
          {
           "sfx": "stinger"
          },
          {
           "sfx": "klaxon"
          },
          {
           "music": 1
          },
          {
           "after": 0.9,
           "do": [
            {
             "say": "fine_print",
             "sub": 3
            }
           ]
          },
          {
           "objective": "Get to the tram. Back through the atrium, then south through Engineering."
          },
          {
           "ambush": "override",
           "delay": 1.2
          },
          {
           "autosave": "events"
          }
         ]
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "on": {
    "event": "doorUnlock",
    "lock": "override"
   },
   "do": [
    {
     "say": "tram_open",
     "sub": 3
    }
   ]
  },
  {
   "on": {
    "event": "doorDenied",
    "lock": "power"
   },
   "once": true,
   "do": [
    {
     "say": "no_power",
     "sub": 2.6
    }
   ]
  },
  {
   "on": {
    "event": "useDecor",
    "decor": "arcade"
   },
   "do": [
    {
     "msg": "STAR REPO // HIGH SCORE: BUCK 999,990"
    },
    {
     "sfx": "pickup"
    },
    {
     "say": "still_got_it",
     "sub": 2.2
    }
   ]
  },
  {
   "on": {
    "event": "region",
    "zone": "tram",
    "minY": 71.6
   },
   "if": {
    "flag": "override"
   },
   "do": [
    {
     "win": true
    }
   ]
  }
 ],
