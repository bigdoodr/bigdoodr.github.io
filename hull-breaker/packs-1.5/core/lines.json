{
 "speaker": "BUCK",
 "lines": [
  {
   "id": "kill_1",
   "text": "Your contract's been terminated.",
   "role": "kill",
   "sub": 2.6,
   "file": "voice/kill_1.mp3"
  },
  {
   "id": "kill_2",
   "text": "Disarming. Literally.",
   "role": "kill",
   "sub": 2.6,
   "file": "voice/kill_2.mp3"
  },
  {
   "id": "kill_3",
   "text": "Ninety days late, and falling apart.",
   "role": "kill",
   "sub": 2.6,
   "file": "voice/kill_3.mp3"
  },
  {
   "id": "kill_4",
   "text": "Should've read the fine print.",
   "role": "kill",
   "sub": 2.6,
   "file": "voice/kill_4.mp3"
  },
  {
   "id": "kill_5",
   "text": "Hold still. I'm itemizing.",
   "role": "kill",
   "sub": 2.6,
   "file": "voice/kill_5.mp3"
  },
  {
   "id": "kill_6",
   "text": "That's a limb-ited warranty.",
   "role": "kill",
   "sub": 2.6,
   "file": "voice/kill_6.mp3"
  },
  {
   "id": "kill_7",
   "text": "Repossessed.",
   "role": "kill",
   "sub": 2.6,
   "file": "voice/kill_7.mp3"
  },
  {
   "id": "kill_8",
   "text": "Nobody skips out on Gorgon. Not even the dead.",
   "role": "kill",
   "sub": 2.6,
   "file": "voice/kill_8.mp3"
  },
  {
   "id": "secret_first",
   "text": "Every ship's got a junk drawer.",
